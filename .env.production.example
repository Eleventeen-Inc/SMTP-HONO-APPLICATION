# ============================================================
# SMTP API - Production Environment
# ============================================================

NODE_ENV=production
HONO_PORT=4000

BETTER_AUTH_SECRET=change-me-to-random-32-chars
BETTER_AUTH_URL=https://api.eleventeen.net
CLIENT_APP_URL=https://app.eleventeen.net

AUTH_TRUSTED_ORIGINS=https://app.eleventeen.net,https://api.eleventeen.net
AUTH_COOKIE_DOMAIN=.eleventeen.net
AUTH_SECURE_COOKIES=true

DATABASE_URL=postgresql://user:pass@host/db

REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=system@yourdomain.com
SMTP_PASS=change-me
SMTP_CONTAINER_NAME=mailserver

SHARED_DOMAIN=yourdomain.com
SHARED_FROM_EMAIL=onboarding@yourdomain.com
SHARED_DAILY_LIMIT=100

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

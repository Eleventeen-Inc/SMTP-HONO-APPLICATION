# ============================================================
# SMTP API - Environment Configuration
# Copy this file to .env and customize the values below
# ============================================================

# ----------------------------------------------------------
# APP SETTINGS
# ----------------------------------------------------------
NODE_ENV=development
HONO_PORT=3000

# ----------------------------------------------------------
# AUTH (Better Auth)
# ----------------------------------------------------------
BETTER_AUTH_SECRET=change-me-to-random-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ----------------------------------------------------------
# DATABASE (PostgreSQL / Neon)
# ----------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host/db

# ----------------------------------------------------------
# REDIS (for BullMQ queue and rate limiting)
# ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------
# SMTP SERVER CONNECTION (Postfix on same VPS)
# ----------------------------------------------------------
# These credentials connect to the Postfix submission port (587)
# The SMTP_USER must be a valid account on the SMTP server
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=system@yourdomain.com
SMTP_PASS=change-me

# Docker container name of the SMTP server (for domain management via docker exec)
SMTP_CONTAINER_NAME=mailserver

# ----------------------------------------------------------
# SHARED DOMAIN (Free Tier)
# ----------------------------------------------------------
# Users without a custom domain can send from this address
# but ONLY to their own verified email (like Resend's onboarding@resend.dev)
SHARED_DOMAIN=yourdomain.com
SHARED_FROM_EMAIL=onboarding@yourdomain.com
SHARED_DAILY_LIMIT=100

# ----------------------------------------------------------
# OAUTH PROVIDERS (Optional)
# ----------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# SMTP API - Base Environment Template
# Copy values into .env for local development, or use the
# dedicated templates: .env.development.example / .env.production.example
# ============================================================

# ----------------------------------------------------------
# APP SETTINGS
# ----------------------------------------------------------
NODE_ENV=development
HONO_PORT=4000

# ----------------------------------------------------------
# AUTH (Better Auth)
# ----------------------------------------------------------
BETTER_AUTH_SECRET=change-me-to-random-32-chars
BETTER_AUTH_URL=http://localhost:4000
CLIENT_APP_URL=http://localhost:3000

# Comma-separated list of frontend origins allowed to call this API with cookies.
AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=
AUTH_SECURE_COOKIES=false

# ----------------------------------------------------------
# DATABASE (PostgreSQL / Neon)
# ----------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host/db

# ----------------------------------------------------------
# REDIS (BullMQ queue + rate limiting)
# ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------
# SMTP SERVER CONNECTION (Postfix)
# ----------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=system@yourdomain.com
SMTP_PASS=change-me
SMTP_CONTAINER_NAME=mailserver

# ----------------------------------------------------------
# SHARED DOMAIN (Free Tier)
# ----------------------------------------------------------
SHARED_DOMAIN=yourdomain.com
SHARED_FROM_EMAIL=onboarding@yourdomain.com
SHARED_DAILY_LIMIT=100

# ----------------------------------------------------------
# OAUTH PROVIDERS (Optional)
# ----------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
